{
  "name": "IT ContractHub — Email Alerts",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 15 }]
        }
      },
      "id": "node-schedule",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "since",
              "name": "since",
              "value": "={{ new Date(Date.now() - 16 * 60 * 1000).toISOString() }}",
              "type": "string"
            },
            {
              "id": "now",
              "name": "now",
              "value": "={{ new Date().toISOString() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-timestamps",
      "name": "Set Lookback Window",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/LinkedinScrapeResults",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Accept",        "value": "application/json" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select",     "value": "id,created_at,JobTitle,Company,Location,PayRate,IR35Status,URL,Description" },
            { "name": "created_at", "value": "=gte.{{ $('Set Lookback Window').item.json.since }}" },
            { "name": "order",      "value": "created_at.desc" },
            { "name": "limit",      "value": "200" }
          ]
        },
        "options": {}
      },
      "id": "node-fetch-contracts",
      "name": "Fetch New Contracts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "has-contracts",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-contracts",
      "name": "Has New Contracts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/alerts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Accept",        "value": "application/json" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select",  "value": "id,user_id,keywords,frequency,match_count" },
            { "name": "enabled", "value": "eq.true" }
          ]
        },
        "options": {}
      },
      "id": "node-fetch-alerts",
      "name": "Fetch Active Alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1120, 180]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// ─────────────────────────────────────────────────────────────────\n// Match new contracts against every active alert.\n// Groups results by user so one email covers all their matches.\n// ─────────────────────────────────────────────────────────────────\n\nconst contracts = $('Fetch New Contracts').first().json;   // array from Supabase\nconst alerts    = $input.all().map(i => i.json);           // array from Supabase\n\n// ── Keyword matching ──────────────────────────────────────────────\n// keywords field: free text, comma-separated OR logic between phrases,\n// space-separated AND logic within a phrase.\n// e.g. \"Python developer, React\" matches if the text has\n// (Python AND developer) OR (React).\nfunction matches(contract, keywords) {\n  const hay = [\n    contract.JobTitle,\n    contract.Description,\n    contract.Location,\n    contract.Company,\n  ].filter(Boolean).join(' ').toLowerCase();\n\n  const phrases = keywords\n    .toLowerCase()\n    .split(',')\n    .map(p => p.trim())\n    .filter(Boolean);\n\n  return phrases.some(phrase => {\n    const words = phrase.split(/\\s+/).filter(w => w.length > 1);\n    return words.length > 0 && words.every(w => hay.includes(w));\n  });\n}\n\n// ── Group by user ─────────────────────────────────────────────────\nconst userMap = new Map();\n\nfor (const alert of alerts) {\n  const matched = contracts.filter(c => matches(c, alert.keywords));\n  if (matched.length === 0) continue;\n\n  const uid = alert.user_id;\n  if (!userMap.has(uid)) {\n    userMap.set(uid, {\n      user_id: uid,\n      alerts_triggered: [],\n      contract_ids: new Set(),\n      contracts: [],\n    });\n  }\n\n  const entry = userMap.get(uid);\n  entry.alerts_triggered.push({\n    id:       alert.id,\n    keywords: alert.keywords,\n    count:    matched.length,\n  });\n\n  for (const c of matched) {\n    if (!entry.contract_ids.has(c.id)) {\n      entry.contract_ids.add(c.id);\n      entry.contracts.push(c);\n    }\n  }\n}\n\n// ── Return one item per user ──────────────────────────────────────\nreturn Array.from(userMap.values())\n  .filter(u => u.contracts.length > 0)\n  .map(u => ({\n    json: {\n      user_id:           u.user_id,\n      alerts_triggered:  u.alerts_triggered,\n      contracts:         u.contracts,\n      contract_count:    u.contracts.length,\n      all_user_ids:      Array.from(userMap.keys()), // passed down for profile fetch\n    },\n  }));\n"
      },
      "id": "node-match",
      "name": "Match Contracts to Alerts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 180]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "has-matches",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-matches",
      "name": "Has Matches?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1560, 180]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/profiles",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Accept",        "value": "application/json" }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "select", "value": "id,email,full_name" },
            {
              "name": "id",
              "value": "=in.({{ $input.all().map(i => i.json.user_id).join(',') }})"
            }
          ]
        },
        "options": {}
      },
      "id": "node-fetch-profiles",
      "name": "Fetch User Profiles",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1780, 60]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Merge email addresses from profiles into each user's match data\nconst profiles = $('Fetch User Profiles').first().json; // array\nconst matches  = $('Has Matches?').all().map(i => i.json);\n\nconst profileMap = new Map(profiles.map(p => [p.id, p]));\n\nreturn matches\n  .map(m => {\n    const profile = profileMap.get(m.user_id);\n    if (!profile?.email) return null; // skip users with no email\n    return {\n      json: {\n        ...m,\n        email:     profile.email,\n        full_name: profile.full_name || null,\n      },\n    };\n  })\n  .filter(Boolean);\n"
      },
      "id": "node-merge-profiles",
      "name": "Merge Profiles",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 60]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "node-loop",
      "name": "Loop Over Users",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [2220, 60]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// ─────────────────────────────────────────────────────────────────\n// Build a branded HTML email for one user\n// ─────────────────────────────────────────────────────────────────\nconst user      = $input.first().json;\nconst contracts = user.contracts.slice(0, 10); // cap at 10 per email\nconst greeting  = user.full_name ? `Hi ${user.full_name.split(' ')[0]}` : 'Hi there';\n\n// Keyword summary line\nconst kwList = user.alerts_triggered\n  .map(a => `\"${a.keywords}\"` )\n  .join(', ');\n\n// Build contract rows\nconst rows = contracts.map(c => {\n  const title    = c.JobTitle   || 'Contract Role';\n  const company  = c.Company    || '';\n  const location = c.Location   || '';\n  const rate     = c.PayRate    || '';\n  const ir35     = c.IR35Status ? ` · ${c.IR35Status}` : '';\n  const link     = c.URL || `https://itcontracthub.co.uk/contract/${c.id}`;\n  const detail   = [company, location].filter(Boolean).join(' · ');\n\n  return `\n    <tr>\n      <td style=\"padding:14px 16px;border-bottom:1px solid #e5e7eb;vertical-align:top;\">\n        <a href=\"https://itcontracthub.co.uk/contract/${c.id}\" style=\"font-weight:600;color:#1d4ed8;text-decoration:none;font-size:15px;\">${title}</a>\n        <br/>\n        <span style=\"color:#6b7280;font-size:13px;\">${detail}${ir35}</span>\n      </td>\n      <td style=\"padding:14px 16px;border-bottom:1px solid #e5e7eb;vertical-align:top;white-space:nowrap;\">\n        ${rate ? `<span style=\"color:#16a34a;font-weight:600;font-size:14px;\">${rate}</span>` : '<span style=\"color:#9ca3af;font-size:13px;\">—</span>'}\n      </td>\n      <td style=\"padding:14px 16px;border-bottom:1px solid #e5e7eb;vertical-align:top;\">\n        <a href=\"${link}\" style=\"display:inline-block;background:#1d4ed8;color:#fff;padding:6px 14px;border-radius:6px;text-decoration:none;font-size:13px;font-weight:500;white-space:nowrap;\">View Role</a>\n      </td>\n    </tr>`;\n}).join('');\n\nconst overflow = user.contracts.length > 10\n  ? `<p style=\"color:#6b7280;font-size:13px;margin:12px 0 0;\">+ ${user.contracts.length - 10} more matching contracts on IT ContractHub.</p>`\n  : '';\n\nconst html = `<!DOCTYPE html>\n<html lang=\"en\">\n<head><meta charset=\"UTF-8\"/><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/></head>\n<body style=\"margin:0;padding:0;background:#f3f4f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f3f4f6;padding:32px 16px;\">\n    <tr><td align=\"center\">\n      <table width=\"100%\" style=\"max-width:600px;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,0.08);\">\n\n        <!-- Header -->\n        <tr>\n          <td style=\"background:linear-gradient(135deg,#1e40af 0%,#2563eb 100%);padding:28px 32px;\">\n            <p style=\"margin:0 0 4px;font-size:12px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#bfdbfe;\">IT ContractHub</p>\n            <h1 style=\"margin:0;font-size:22px;font-weight:700;color:#ffffff;line-height:1.3;\">🔔 ${user.contract_count} new contract${user.contract_count !== 1 ? 's' : ''} matching your alerts</h1>\n            <p style=\"margin:8px 0 0;font-size:14px;color:#bfdbfe;\">Matching: ${kwList}</p>\n          </td>\n        </tr>\n\n        <!-- Body -->\n        <tr>\n          <td style=\"padding:28px 32px;\">\n            <p style=\"margin:0 0 20px;font-size:15px;color:#374151;\">${greeting},</p>\n            <p style=\"margin:0 0 24px;font-size:15px;color:#374151;\">We found <strong>${user.contract_count} new contract${user.contract_count !== 1 ? 's' : ''}</strong> matching your saved alerts. Be first to apply:</p>\n\n            <!-- Contracts table -->\n            <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;\">\n              <thead>\n                <tr style=\"background:#f9fafb;\">\n                  <th style=\"padding:10px 16px;text-align:left;font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:0.05em;\">Role</th>\n                  <th style=\"padding:10px 16px;text-align:left;font-size:11px;font-weight:600;color:#9ca3af;text-transform:uppercase;letter-spacing:0.05em;\">Rate</th>\n                  <th style=\"padding:10px 16px;\"></th>\n                </tr>\n              </thead>\n              <tbody>${rows}</tbody>\n            </table>\n\n            ${overflow}\n\n            <!-- CTA -->\n            <div style=\"text-align:center;margin:32px 0 8px;\">\n              <a href=\"https://itcontracthub.co.uk/contracts\" style=\"display:inline-block;background:#1d4ed8;color:#ffffff;padding:14px 32px;border-radius:10px;text-decoration:none;font-weight:600;font-size:15px;\">Browse All Contracts →</a>\n            </div>\n          </td>\n        </tr>\n\n        <!-- Footer -->\n        <tr>\n          <td style=\"padding:20px 32px;border-top:1px solid #e5e7eb;background:#f9fafb;\">\n            <p style=\"margin:0;font-size:12px;color:#9ca3af;text-align:center;line-height:1.6;\">\n              You're receiving this because you set up an alert on\n              <a href=\"https://itcontracthub.co.uk\" style=\"color:#6b7280;\">IT ContractHub</a>.<br/>\n              <a href=\"https://itcontracthub.co.uk/alerts\" style=\"color:#6b7280;\">Manage or pause your alerts</a>\n            </p>\n          </td>\n        </tr>\n\n      </table>\n    </td></tr>\n  </table>\n</body>\n</html>`;\n\nconst subject = `🔔 ${user.contract_count} new contract${user.contract_count !== 1 ? 's' : ''} matching ${user.alerts_triggered.map(a => `\"${a.keywords}\"`).join(', ')}`;\n\nreturn [{ json: { ...user, emailHtml: html, subject } }];\n"
      },
      "id": "node-build-email",
      "name": "Build Email HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2440, 60]
    },
    {
      "parameters": {
        "fromEmail": "alerts@itcontracthub.co.uk",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "html",
        "html": "={{ $json.emailHtml }}",
        "options": {}
      },
      "id": "node-send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [2660, 60],
      "credentials": {
        "smtp": {
          "id": "REPLACE_WITH_YOUR_SMTP_CREDENTIAL_ID",
          "name": "SMTP — IT ContractHub"
        }
      }
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Increment match_count on each alert that fired this run.\n// Runs once per user after their email is sent.\nconst user = $input.first().json;\nreturn user.alerts_triggered.map(a => ({\n  json: {\n    alert_id:  a.id,\n    increment: a.count,\n  },\n}));\n"
      },
      "id": "node-prep-updates",
      "name": "Prepare Count Updates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2880, 60]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/alerts?id=eq.{{ $json.alert_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey",         "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization",  "value": "=Bearer {{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Content-Type",   "value": "application/json" },
            { "name": "Prefer",         "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"match_count\": {{ $json.increment }},\n  \"updated_at\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {}
      },
      "id": "node-update-count",
      "name": "Update Alert Match Count",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [3100, 60],
      "notes": "Uses Supabase RPC increment. If you prefer a true increment (not overwrite), call a Postgres function instead."
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [[{ "node": "Set Lookback Window", "type": "main", "index": 0 }]]
    },
    "Set Lookback Window": {
      "main": [[{ "node": "Fetch New Contracts", "type": "main", "index": 0 }]]
    },
    "Fetch New Contracts": {
      "main": [[{ "node": "Has New Contracts?", "type": "main", "index": 0 }]]
    },
    "Has New Contracts?": {
      "main": [
        [{ "node": "Fetch Active Alerts", "type": "main", "index": 0 }],
        []
      ]
    },
    "Fetch Active Alerts": {
      "main": [[{ "node": "Match Contracts to Alerts", "type": "main", "index": 0 }]]
    },
    "Match Contracts to Alerts": {
      "main": [[{ "node": "Has Matches?", "type": "main", "index": 0 }]]
    },
    "Has Matches?": {
      "main": [
        [{ "node": "Fetch User Profiles", "type": "main", "index": 0 }],
        []
      ]
    },
    "Fetch User Profiles": {
      "main": [[{ "node": "Merge Profiles", "type": "main", "index": 0 }]]
    },
    "Merge Profiles": {
      "main": [[{ "node": "Loop Over Users", "type": "main", "index": 0 }]]
    },
    "Loop Over Users": {
      "main": [
        [{ "node": "Build Email HTML", "type": "main", "index": 0 }],
        []
      ]
    },
    "Build Email HTML": {
      "main": [[{ "node": "Send Email", "type": "main", "index": 0 }]]
    },
    "Send Email": {
      "main": [[{ "node": "Prepare Count Updates", "type": "main", "index": 0 }]]
    },
    "Prepare Count Updates": {
      "main": [[{ "node": "Update Alert Match Count", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": ["email", "alerts", "contracts"]
}
